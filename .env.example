# ─── Studio 13 — Environment Variables Example ───────────────────────────────
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git!

# ── Admin panel password (/admin) ─────────────────────────────────────────────
# Default: studio13admin — ОБЯЗАТЕЛЬНО смени перед деплоем!
ADMIN_PASSWORD=studio13admin

# ── Site URL (required for absolute links & OG tags) ──────────────────────────
NEXT_PUBLIC_SITE_URL=https://studio13ufa.ru

# ── Form submission (choose one) ──────────────────────────────────────────────
# Option 1: Telegram bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Option 2: Email via Resend
RESEND_API_KEY=your_resend_api_key_here
CONTACT_EMAIL=studio13@mail.ru

# ── Instagram (if using embedded feed) ───────────────────────────────────────
# INSTAGRAM_ACCESS_TOKEN=your_instagram_token_here

# ── Google Analytics ──────────────────────────────────────────────────────────
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Yandex Metrika ────────────────────────────────────────────────────────────
# NEXT_PUBLIC_METRIKA_ID=12345678
